# Conventions d'édition partagées (https://editorconfig.org).
# Outille la cohérence de base (indentation, fins de ligne, encodage) que le
# linter ESLint ne couvre volontairement pas.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{png,pptx,pdf,db,xlsx}]
insert_final_newline = false
trim_trailing_whitespace = false
