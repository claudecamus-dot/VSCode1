# Contrat de configuration de l'application (US8.2).
# Toutes ces variables ont un defaut dans le code ; ce fichier les documente et
# sert de base aux fichiers .env par environnement (.env.dev / .env.preprod /
# .env.prod). Node >= 20.6 charge un fichier via :  node --env-file=.env.dev src/server.js
# Ne PAS committer de vrai .env (donnees/chemins machine) — seulement ce .example.

# Environnement logique, affiche dans le bandeau de l'UI : DEV | PRE-PROD | PROD
APP_ENV=DEV

# Port HTTP d'ecoute.
PORT=3000

# Chemin du fichier SQLite (= toutes les donnees persistantes). Un par
# environnement pour les isoler (Epic 9). Cree au premier demarrage si absent.
DB_PATH=./data/app.db

# Dossier ou ecrire les sauvegardes DB (defaut : <dossier de DB_PATH>/backups).
# BACKUP_DIR=./data/backups

# (CHROME_PATH retire le 2026-07-21 : l'export PPT est 100% Python, le radar est
#  vectoriel, plus de rasterisation Chrome/Puppeteer.)

# Interpreteur Python (export PPT via python-pptx, US6.4).
PYTHON=python

# Barriere d'acces INTERIMAIRE (Basic Auth) sur la surface animateur / PII, en
# attendant l'Epic 10 (authentification produit). Voir cadrage/epics-us.md et
# src/auth.js. La barriere ne s'active QUE si les DEUX variables sont posees ;
# laissees vides (defaut) le comportement est inchange. Le parcours repondant
# reste toujours ouvert (US10.5). Poser de VRAIS identifiants uniquement dans le
# .env de PROD (jamais committe), pas ici.
# AUTH_USER=animateur
# AUTH_PASS=change-moi-en-prod
