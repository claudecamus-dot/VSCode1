# Contrat de configuration de l'application (US8.2).
# Toutes ces variables ont un defaut dans le code ; ce fichier les documente et
# sert de base aux fichiers .env par environnement (.env.dev / .env.preprod /
# .env.prod). Node >= 20.6 charge un fichier via :  node --env-file=.env.dev src/server.js
#
# DEUX CANAUX, a ne pas confondre :
#   1. .env.dev / .env.preprod / .env.prod — VERSIONNES dans git, a dessein : ils ne
#      portent que du parametrage d'environnement (APP_ENV, PORT, DB_PATH), utile a
#      toute l'equipe. Ils ne doivent JAMAIS contenir d'identifiant ni de secret.
#   2. .env.dev.local / .env.preprod.local / .env.prod.local — IGNORES par git
#      (app/.gitignore), charges en second par --env-file-if-exists (scripts start:*).
#      C'est LA que vont AUTH_USER / AUTH_PASS et tout autre secret. Le fichier peut
#      ne pas exister : le demarrage fonctionne sans lui.
# Un secret pose dans le canal 1 part dans l'historique git. Le test
# scripts/test-env-sans-secret.js (chaine dans npm test) echoue si cela arrive.

# Environnement logique, affiche dans le bandeau de l'UI : DEV | PRE-PROD | PROD
APP_ENV=DEV

# Port HTTP d'ecoute.
PORT=3000

# Chemin du fichier SQLite (= toutes les donnees persistantes). Un par
# environnement pour les isoler (Epic 9). Cree au premier demarrage si absent.
DB_PATH=./data/app.db

# Dossier ou ecrire les sauvegardes DB (defaut : <dossier de DB_PATH>/backups).
# BACKUP_DIR=./data/backups

# CHROME_PATH n'est plus utilise par l'export PPT depuis le 2026-07-21 (export 100%
# Python, radar vectoriel, plus de rasterisation). Il reste lu par le seul
# scripts/capture-screenshots.js (outil manuel de captures pour le cadrage, hors
# npm test), avec un defaut sur l'installation Chrome standard de Windows.
# CHROME_PATH=C:/Program Files/Google/Chrome/Application/chrome.exe

# Dossier de sortie des captures de capture-screenshots.js (defaut : ../cadrage/captures).
# CAPTURES_OUT=../cadrage/captures

# Interpreteur Python (export PPT via python-pptx, US6.4).
PYTHON=python

# Barriere d'acces INTERIMAIRE (Basic Auth) sur la surface animateur / PII, en
# attendant l'Epic 10 (authentification produit). Voir cadrage/epics-us.md et
# src/auth.js. La barriere ne s'active QUE si les DEUX variables sont posees ;
# laissees vides (defaut) le comportement est inchange. Le parcours repondant
# reste toujours ouvert (US10.5). Les VRAIS identifiants se posent dans
# app/.env.prod.local — le canal ignore par git (cf. en-tete), jamais dans
# .env.prod qui est versionne, ni ici.
# AUTH_USER=animateur
# AUTH_PASS=change-moi-en-prod
